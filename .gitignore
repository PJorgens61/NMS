.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/
*.profraw
# Local Claude Code settings (Bash allowlist) — machine-specific, not
# something a clone should inherit. `skills/` is the one exception:
# skill definitions are project tooling, not per-machine config, and are
# worth sharing with anyone else working in this repo.
.claude/*
!.claude/skills/

# The `skills` npx CLI's own reproducibility manifest for whatever it
# last installed on this machine -- tooling metadata, not the skill
# content itself (that's .claude/skills/, tracked above). Regenerable
# from a fresh `npx skills add`, not needed by a clone.
skills-lock.json

# A snapshot of a real, populated SwiftData store, used as a test fixture
# by script/save-fixture.sh / script/scenarios.sh-style scripts so tests
# needing pre-existing history (known networks, SNMP devices, DHCP
# leases) don't have to build it up from scratch or touch the real store.
# Never committed: it contains real personal network data (MACs, device
# hostnames, router info) and this repo is public.
script/fixtures/

# Field-test documentation screenshots from script/capture-doc-scenarios.sh.
# Never committed, same reason as script/fixtures/ above — these crops
# contain real values (e.g. the DNS row's actual server IP) until a
# sanitization pass exists.
script/doc-captures/

# Diagnostic exports from script/export-diagnostic.sh -- real network
# identifiers (IPs, router MAC, SNMP descriptors), always private, no
# public-sharing path exists for these. Never committed.
script/diagnostic-exports/
